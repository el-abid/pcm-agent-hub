# Server
PORT=8787
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Run mode: api_key (Langflow API key) or public (staging public run endpoint)
LANGFLOW_RUN_MODE=public
LANGFLOW_PUBLIC_USER_ID=

# Langflow / Abafusion staging
LANGFLOW_BASE_URL=https://stg-agentic.abafusion.ai
LANGFLOW_API_KEY=replace-with-langflow-api-key
MCP_SERVER_URL=https://your-mcp-tunnel.trycloudflare.com/mcp
ATLAS_URI=mongodb://user:password@host1:27017,host2:27017,host3:27017/?authSource=admin&retryWrites=true&w=majority&tls=true

# Shared secret used by the orchestrator when calling the A2A gateway
A2A_BEARER_TOKEN=replace-with-a-long-random-token

# Timeouts
A2A_REQUEST_TIMEOUT_MS=60000
A2A_RETRY_COUNT=1
A2A_LOG_FILE=logs/a2a-requests.ndjson
AUTO_LOG_INTERACTIONS=true

# Flow IDs created in project J35
LANGFLOW_FLOW_ORCHESTRATOR=
LANGFLOW_FLOW_DOCS=
LANGFLOW_FLOW_DISTRIBUTOR=
LANGFLOW_FLOW_SUPPORT=
LANGFLOW_FLOW_LOGGER=
LANGFLOW_FLOW_EQUIPMENT=
LANGFLOW_FLOW_DEGRADED=
LANGFLOW_FLOW_CRITIC=
